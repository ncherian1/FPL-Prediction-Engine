# Local docker Postgres (docker compose up -d). For Supabase use the "Session pooler"
# connection string from Project Settings -> Database.
DATABASE_URL=postgresql://fpl:fpl@localhost:5432/fpl

# Where raw API payloads are archived (gzipped, content-addressed).
ARCHIVE_DIR=data/archive

# Supplementary providers — free keys. Leave blank to skip those sources.
# https://pitchapi.dev  (free, unlimited fair use)
PITCHAPI_API_KEY=
# https://strikerapi.com (500 free credits / month)
STRIKERAPI_API_KEY=

# Polite identification sent to providers.
HTTP_USER_AGENT=fpl-prediction-engine/0.1
